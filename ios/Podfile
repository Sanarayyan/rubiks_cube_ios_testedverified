# The secondary target index is used in Podfile.lock to distinguish between
# the same pod in different targets. This is used by pod install.
install! 'cocoapods', :deterministic_uuids => false

# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# Read this Mac's SDK path generated by flutter pub get.
def flutter_root
  generated_config = File.expand_path('Flutter/Generated.xcconfig', __dir__)
  raise "Run flutter pub get before pod install" unless File.exist?(generated_config)

  File.foreach(generated_config) do |line|
    match = line.match(/^FLUTTER_ROOT=(.*)$/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT missing from #{generated_config}; run flutter pub get"
end

require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
